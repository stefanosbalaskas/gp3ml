cff-version: 1.2.0
message: "If you use gp3ml, please cite the software using this metadata."
title: "gp3ml: Governance-First Predictive Modelling for Gazepoint Research"
type: software
authors:
  - family-names: Balaskas
    given-names: Stefanos
    orcid: "https://orcid.org/0000-0003-2444-9796"
    website: "https://sites.google.com/view/stefbalaskas/"
version: "0.3.0"
identifiers:
  - description: "Zenodo concept DOI for all versions of gp3ml."
    type: doi
    value: "10.5281/zenodo.21487272"
  - description: "Persistent CRAN package DOI for gp3ml."
    type: doi
    value: "10.32614/CRAN.package.gp3ml"
repository-code: "https://github.com/stefanosbalaskas/gp3ml"
url: "https://stefanosbalaskas.github.io/gp3ml/"
license: MIT
abstract: >-
  Governance-first infrastructure for leakage-resistant predictive
  modelling and validation using Gazepoint-derived research data,
  including task governance, feature provenance, group-aware validation,
  fold-local preprocessing, governed model evaluation, decision-rule
  governance, conformal prediction, dataset-shift auditing, portable
  artifacts, model cards, and reproducibility evidence.
keywords:
  - R package
  - eye tracking
  - machine learning governance
  - leakage auditing
  - grouped resampling
  - conformal prediction
  - reproducibility
